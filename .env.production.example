# Plantilla de variables para producción (ADR-0011).
# Copiar este archivo a .env en el servidor (C:\actualizacion_datos\.env o /opt/actualizacion_datos/.env)
# y completar con credenciales seguras. NUNCA subir el .env con valores reales al repositorio.

# Base de datos PostgreSQL
POSTGRES_DB=actualizacion_datos_prod
POSTGRES_USER=istpet_app
POSTGRES_PASSWORD=defina_una_contrasenia_segura_aqui

# Versión o tag de las imágenes Docker (actualizado por el workflow de deploy)
TAG=latest

# Puerto local expuesto para el proxy inverso (hacia donde apunta Cloudflare Tunnel)
PUERTO_PUBLICO=8088

# Configuración del servidor de correo institucional (Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PUERTO=587
SMTP_USUARIO=notificaciones@institucion.edu.ec
SMTP_CONTRASENIA=credencial_secreta_smtp
SMTP_REMITENTE=notificaciones@institucion.edu.ec

# Cuenta bancaria (ADR-0013). Dos claves distintas, de 32 bytes en Base64. Generarlas en el servidor con:
#   openssl rand -base64 32
# Respaldarlas aparte de la base: si se pierde CUENTA_BANCARIA_CLAVE_CIFRADO, los números cifrados no se recuperan.
# Si se cambia CUENTA_BANCARIA_CLAVE_HUELLA, las comparaciones con la nómina anterior dejan de coincidir.
CUENTA_BANCARIA_CLAVE_CIFRADO=
CUENTA_BANCARIA_CLAVE_HUELLA=
