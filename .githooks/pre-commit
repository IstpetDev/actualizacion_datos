#!/bin/sh
# Hook de pre-commit para prevenir commits con credenciales o secretos en local

GITLEAKS_CMD=""
if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_CMD="gitleaks"
elif command -v gitleaks.exe >/dev/null 2>&1; then
    GITLEAKS_CMD="gitleaks.exe"
fi

if [ -n "$GITLEAKS_CMD" ]; then
    echo "Verificando secretos con gitleaks..."
    $GITLEAKS_CMD protect --staged --verbose --redact
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
        echo ""
        echo "======================================================================"
        echo " [ERROR DE SEGURIDAD] Gitleaks detecto posibles secretos o credenciales"
        echo " en los archivos en stage. El commit fue bloqueado."
        echo " Remueva las claves o use variables de entorno antes de continuar."
        echo "======================================================================"
        echo ""
        exit 1
    fi
else
    echo "[AVISO] gitleaks no esta instalado en el PATH. No se pudo verificar la presencia de secretos."
fi
