        ],
        "type": "object",
        "properties": {
          "documento": {
            "type": "string"
          },
          "nombre": {
            "type": [
              "null",
              "string"
            ]
          },
          "correo": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PersonaDto": {
        "required": [
          "id",
          "institucionId",
          "documento",
          "nombre",
          "correo",
          "rol",
          "accesoHabilitado",
          "estadoActualizacion",
          "fechaCreacionUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institucionId": {
            "type": "string",
            "format": "uuid"
          },
          "documento": {
            "type": "string"
          },
          "nombre": {
            "type": [
              "null",
              "string"
            ]
          },
          "correo": {
            "type": [
              "null",
              "string"
            ]
          },
          "rol": {
            "type": "string"
          },
          "accesoHabilitado": {
            "type": "boolean"
          },
          "estadoActualizacion": {
            "type": "string"
          },
          "fechaCreacionUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RespuestaDeSalud": {
        "required": [
          "estado"
        ],
        "type": "object",
        "properties": {
          "estado": {
            "type": "string"
          }
        }
      },
      "ResultadoCargaPersonasDto": {
        "required": [
          "totalRecibidos",
          "totalCargados",
          "totalDuplicadosOmitidos",
          "documentosCargados"
        ],
        "type": "object",
        "properties": {
          "totalRecibidos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCargados": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalDuplicadosOmitidos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "documentosCargados": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubirArchivoRequest": {
        "required": [
          "nombreArchivo",
          "tipoContenido",
          "tamanoBytes"
        ],
        "type": "object",
        "properties": {
          "nombreArchivo": {
            "type": "string"
          },
          "tipoContenido": {
            "type": "string"
          },
          "tamanoBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      }
    }
